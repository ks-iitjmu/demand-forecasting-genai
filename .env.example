# Copy to .env and fill in. Never commit .env.
LLM_PROVIDER=gemini               # gemini or ollama
GEMINI_API_KEY=your-key-from-aistudio.google.com
LLM_MODEL=gemini-3.8-flash        # pinned for reproducible summaries; python scripts/check_llm.py lists alternatives
# OLLAMA_URL=http://localhost:11434
# XGB_DEVICE=cuda                 # train XGBoost on an NVIDIA GPU (default: cpu)
